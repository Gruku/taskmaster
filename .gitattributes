# User intent: shell scripts and the Linux deploy files keep LF endings even in a Windows checkout
# (core.autocrlf=true here), so bash in WSL and systemd/Caddy on the host can read them as checked out.
*.sh text eol=lf
deploy/** text eol=lf
.github/workflows/*.yml text eol=lf
# Rust relay (local-server-011): byte-exact entry script and binaries
bin/tm-relay text eol=lf
bin/tm-relay-* binary
bin/*.exe binary
bin/relay-manifest.json text eol=lf
